# ========================================================
# OpenWingman / RizzCoach - Environment Configuration (BYOK)
# ========================================================

# LLM Provider Configuration
# Supported providers: "openai", "groq", "anthropic", "gemini", "ollama", "mock"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# Local Ollama Configuration (Free, 100% Private)
# If using Ollama, set LLM_PROVIDER=ollama, LLM_MODEL=llama3.2 or deepseek-r1
OLLAMA_BASE_URL=http://localhost:11434

# Automation Engine Settings
AUTOMATION_MODE=copilot # "copilot" (human approval) or "autonomous" (auto-sends)
AUTOMATION_MIN_DELAY_SECONDS=180
AUTOMATION_MAX_DELAY_SECONDS=720
ALERT_ON_CONVERSION=true

# Mobile Wingman Integrations (Optional)
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
DATABASE_PATH=rizz_coach.db
